# Optional: override only if deploying Hono at a separate public origin.
# Leave unset for Cloudflare Pages; /api/* is served on the same domain.
# NEXT_PUBLIC_API_URL=https://api.example.com
# No AniList API key or client secret is required for public search.

# Giscus comments (https://giscus.app). Enable Discussions on the GitHub repo, install the
# Giscus app, create a "Story threads" category (Announcements type), then paste its ID here.
NEXT_PUBLIC_GISCUS_REPO=Phantom-Con-Artist/animepoodle
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOVNeddA
NEXT_PUBLIC_GISCUS_CATEGORY=Story threads
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Hype production settings are runtime Pages variables/secrets, not NEXT_PUBLIC build vars.
# HYPE_DB: D1 binding (npm run hype:database, then npm run hype:migrate).
# TURNSTILE_SITE_KEY: public widget key, configured in Pages runtime variables.
# TURNSTILE_SECRET_KEY: encrypted Pages secret.
# HYPE_HASH_SECRET: encrypted Pages secret, at least 32 random characters.
# HYPE_DAILY_VOTE_CAP: global accepted-vote circuit breaker (default 2000/day).
# Never enable HYPE_LOCAL_DEV on Cloudflare; npm run dev uses it only on localhost.
# See docs/hype.md for the complete setup and required edge rate-limit rule.

# Reading: MangaDex group, series or chapter IDs to hide after a removal request
# (comma or space separated). Set it as a Pages environment variable in production.
# READ_BLOCKLIST=
